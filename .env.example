# Vision Stones - Environment Variables Example
# Copy this file to .env.local for local testing
# Configure actual production variables in Vercel / Host settings

# Resend API Key for Email Delivery
RESEND_API_KEY=

# Receiver Email Address for Web Enquiries
CONTACT_RECEIVER_EMAIL=visionstones.22@gmail.com

# Verified Sender Email Address in Resend (e.g., Vision Stones <onboarding@resend.dev> or sales@visionstone.in)
CONTACT_FROM_EMAIL=Vision Stones <onboarding@resend.dev>
